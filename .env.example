# Salin file ini menjadi ".env" lalu isi nilainya sendiri.
# JANGAN pernah membagikan file .env yang sudah terisi ke siapa pun.

# String acak panjang untuk menandatangani sesi login. Ganti dengan nilai acak Anda sendiri,
# contoh cara membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_yang_sangat_panjang

# Port server (opsional, default 3000)
PORT=3000

# NODE_ENV=production mengaktifkan cookie "secure" (butuh HTTPS)
NODE_ENV=development
