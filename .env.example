# Salin file ini menjadi ".env" HANYA jika menjalankan di komputer sendiri.
# Kalau di-deploy ke hosting (Render, dll), isi nilai-nilai ini lewat halaman
# "Environment Variables" di dashboard hosting tersebut, bukan file ini.
# JANGAN pernah membagikan file .env yang sudah terisi ke siapa pun.

# --- Database permanen gratis (Turso) ---
# Kosongkan kedua baris ini untuk memakai file lokal (cukup untuk coba-coba
# di komputer sendiri). WAJIB diisi kalau di-deploy ke host yang tidak
# punya penyimpanan file permanen (misalnya Render free tier).
# Dapatkan dari dashboard Turso (turso.tech) setelah membuat database gratis.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Kunci sesi login (opsional) ---
# Kalau dikosongkan, sistem akan membuat sendiri secara otomatis dan
# menyimpannya di data/.jwt_secret. Hanya perlu diisi manual kalau host Anda
# TIDAK punya penyimpanan file permanen sama sekali (lihat README).
JWT_SECRET=

# Port server (opsional, kebanyakan host mengisi ini otomatis)
PORT=3000

# NODE_ENV=production mengaktifkan cookie "secure" (butuh HTTPS)
NODE_ENV=development
